# Copy this file to .env and adjust only for your local setup.
APP_NAME=SkyFiber Voice Agent
APP_ENV=development
DEBUG=false
DATABASE_URL=sqlite:///./data/skyfiber.db

# Local Ollama endpoint. No paid API key is needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT=5
LLM_REPLY_TIMEOUT=6
LLM_CONNECT_TIMEOUT=3
ENABLE_LLM_REPLY_GENERATION=false

# The tiny model is loaded only on the first transcription and only from cache.
# Run `python scripts/download_stt_model.py` explicitly to fetch it if absent.
STT_MODEL_SIZE=tiny
# Reversible STT-only experiment selector. Keep baseline for normal use.
# Options: baseline, beam3, auto_language, condition_context, vad_filter, base_model
STT_EXPERIMENT=baseline
INITIAL_RESPONSE_TIMEOUT_SEC=9
NO_INPUT_TIMEOUT_SEC=7
REMINDER_GRACE_SEC=6
TIMEOUT_EDGE_GRACE_SEC=0.40
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_TIMEOUT_SEC=25
TTS_TIMEOUT_SEC=30
TTS_FRAME_CACHE_BYTES=4194304

VAD_RMS_THRESHOLD=500
END_OF_TURN_SILENCE_MS=800
BARGE_IN_MIN_SPEECH_MS=280
